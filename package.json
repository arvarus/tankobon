{
  "name": "tankobon",
  "productName": "Tankōbon",
  "version": "0.6.0",
  "description": "Digital comics, BD and manga library manager and reader.",
  "main": ".vite/build/main.cjs",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "dev": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "icons": "node scripts/gen-icons.mjs",
    "docs:gen": "node --disable-warning=ExperimentalWarning scripts/gen-reference.mjs",
    "docs:api": "typedoc",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:build": "npm run docs:gen && npm run docs:api && npm run docs:check && vitepress build docs",
    "docs:dev": "npm run docs:gen && npm run docs:api && vitepress dev docs"
  },
  "keywords": [
    "electron",
    "comics",
    "manga",
    "bd",
    "reader",
    "library"
  ],
  "author": {
    "name": "PPRB",
    "email": "pprb@arvarus.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/core-utils": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.38",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "44.5.1",
    "eslint": "^10.10.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typedoc-vitepress-theme": "^1.1.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@tanstack/react-router": "^1.170.36",
    "@tanstack/react-virtual": "^3.14.13",
    "@tensorflow/tfjs": "~4.11.0",
    "@upscalerjs/default-model": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.20",
    "electron-squirrel-startup": "^1.0.1",
    "i18next": "^26.4.2",
    "lucide-react": "^1.46.0",
    "node-stream-zip": "^1.16.0",
    "node-unrar-js": "^2.0.2",
    "pdfjs-dist": "^6.3.289",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "tailwind-merge": "^3.7.0",
    "upscaler": "^1.0.0"
  }
}
